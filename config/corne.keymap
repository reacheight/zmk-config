#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
            // │ TAB  │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │ BSPC │
            // │ CTRL │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  ;  │  '   │
            // │ SHFT │  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │ ESC  │
            // ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
            //                    │ GUI │ SYM │ SPC │   │ ENT │ NAV │ DEL │
            //                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E         &kp R        &kp T      &kp Y            &kp U            &kp I              &kp O    &kp P     &kp BSPC
&kp LSHIFT  &kp A  &kp S  &kp D         &kp F        &kp G      &kp H            &kp J            &kp K              &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C         &kp V        &kp B      &kp N            &kp M            &kp COMMA          &kp DOT  &kp FSLH  &mt LGUI ESC
                          &kp LEFT_ALT  &lt 1 SPACE  &kp TAB    &mt LCTRL ENTER  &lt 2 BACKSPACE  &mt LEFT_ALT LGUI
            >;
        };

        nav_layer {
            // ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
            // │  `   │  1  │  2  │  3  │  4  │  5  │   │  6  │  7  │  8  │  9  │  0  │ DEL  │
            // │ CAPS │HOME │ PgDn│ PgUp│ END │     │   │  ←  │  ↓  │  ↑  │  →  │ F12 │      │
            // │      │ F1  │ F2  │ F3  │ F4  │ F5  │   │ F6  │ F7  │ F8  │ F9  │ F10 │ F11  │
            // ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
            //                    │ GUI │ SYS │ SPC │   │ ENT │ --- │ DEL │
            //                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯

            bindings = <
&kp GRAVE  &kp N1    &kp N2     &kp N3     &kp N4   &kp N5       &kp N6    &kp N7    &kp N8   &kp N9     &kp N0   &kp DEL
&kp CLCK   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans       &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &kp F12  &trans
&trans     &kp F1    &kp F2     &kp F3     &kp F4   &kp F5       &kp F6    &kp F7    &kp F8   &kp F9     &kp F10  &kp F11
                                &kp LGUI   &mo 3    &kp SPACE    &kp RET   &trans    &kp DEL
            >;
        };

        sym_layer {
            // ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
            // │  ~   │  !  │  @  │  #  │  $  │  %  │   │  ^  │  &  │  *  │  (  │  )  │ DEL  │
            // │      │  `  │  {  │  }  │  [  │  ]  │   │  _  │  =  │  <  │  >  │  :  │  |   │
            // │      │     │  \  │  "  │  '  │ =>  │   │  /  │  ?  │  +  │  -  │  ;  │  ~   │
            // ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
            //                    │ GUI │ --- │ SPC │   │ ENT │ SYS │ DEL │
            //                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯

            bindings = <
&kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp DEL
&trans     &kp GRAVE  &kp LBRC  &kp RBRC  &kp LBKT  &kp RBKT     &kp UNDER  &kp EQUAL  &kp LT     &kp GT     &kp COLON  &kp PIPE
&trans     &trans     &kp BSLH  &kp DQT   &kp SQT   &arrow       &kp FSLH   &kp QMARK  &kp PLUS   &kp MINUS  &kp SEMI   &kp TILDE
                                &kp LGUI  &trans    &kp SPACE    &kp RET    &mo 3      &kp DEL
            >;
        };

        sys_layer {
            // ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
            // │BTCLR │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │   │PREV │STOP │ PP  │NEXT │VOL- │ VOL+ │
            // │      │     │     │     │     │     │   │MUTE │     │     │     │     │      │
            // │      │     │     │     │     │     │   │     │     │     │     │     │      │
            // ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
            //                    │ GUI │ --- │ SPC │   │ ENT │ --- │ DEL │
            //                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp C_PREV  &kp C_STOP  &kp C_PP  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP
&trans      &trans        &trans        &trans        &trans        &trans          &kp C_MUTE  &trans      &trans    &trans      &trans        &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans      &trans      &trans    &trans      &trans        &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET     &trans      &kp DEL
            >;
        };
    };
};

};
